            android:exported="false"
            android:theme="@style/Base.Theme.PMATH"/>
        <activity
            android:name=".ui.density.volume_control.activity_holder.TotalVolumeControlActivity"
            android:exported="false"
            android:theme="@style/Base.Theme.PMATH" />
        <activity
            android:name=".ui.stadis.StadisActivity"
            android:exported="false"
            android:theme="@style/Base.Theme.PMATH" />
        <activity
            android:name=".ui.main.PrivacyPolicyActivity"
            android:exported="false"
            android:theme="@style/Base.Theme.PMATH" />
        <activity
            android:name=".ui.density.volume_control.activity_holder.VolumeControlEditDataActivity"
            android:exported="false"
            android:parentActivityName=".ui.density.volume_control.activity_holder.VolumeControlActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.PMATH" />
        <activity
            android:name=".ui.density.quality_control.activity_holder.BridgerQualityDataEdit"
            android:exported="false"
            android:parentActivityName=".ui.density.quality_control.activity_holder.BridgerQualityControlActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.PMATH" />
        <activity
            android:name=".ui.topping_up.activity.ToppingUpEditData"
            android:exported="false"
            android:parentActivityName=".ui.topping_up.activity.ToppingUpActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Base.Theme.PMATH" />
        <activity
            android:name=".ui.density.volume_control.activity_holder.DataShowActivity"
            android:exported="false"
