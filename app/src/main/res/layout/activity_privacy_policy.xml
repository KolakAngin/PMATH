<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.PrivacyPolicyActivity">

    <ScrollView
        android:id="@+id/privacy_policy_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_back"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/privacy_policy_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_title"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="241dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_pmath" />

            <!-- Template untuk semua text -->
            <TextView
                android:id="@+id/privacy_policy_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_intro"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_info_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_info_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_info"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_third_party_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_third_party_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_third_party"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_third_party"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_opt_out_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_opt_out_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_opt_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_opt_out"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_data_retention_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_data_retention_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_data_retention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_data_retention"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_children_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_children_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_children"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_children"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_security_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_security_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_security"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_changes_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_changes_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_changes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_changes"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_consent_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_consent_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_consent"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

            <TextView
                android:id="@+id/privacy_policy_contact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_contact_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/privacy_policy_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_contact"
                android:textSize="14sp"
                android:paddingBottom="12dp"
                android:ellipsize="none"
                android:scrollHorizontally="false"
                android:justificationMode="inter_word" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
