<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.density.volume_control.fragment.VolumeControlFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:layout_marginBottom="200dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FORM ANALISA BONGKAR BRIDGER"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                style="@style/Widget.Material3.MaterialTimePicker.Button"
                android:id="@+id/button_tangal_bongkar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tanggal Bongkar" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="15dp">

                <AutoCompleteTextView
                    android:id="@+id/spinner_aft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="AFT"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="15dp">

                <AutoCompleteTextView
                    android:id="@+id/spinner_supply_point"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Supply Point"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_marginBottom="15dp">

                <AutoCompleteTextView
                    android:id="@+id/spinner_transportir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Transportir"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_no_polisi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="No. Polisi Bridger"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_kuantitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Kuantitas"
                    android:inputType="numberDecimal" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_harga_avtur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Harga Avtur (Include Tax)"
                    android:inputType="numberDecimal" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_spv_rsd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Spv RSD"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_sopir_bridger_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pengemudi Bridger 1"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_sopir_bridger_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pengemudi Bridger 2"
                    android:inputType="textCapWords" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/txt_kompartemen_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KOMPARTEMEN 1"
                android:layout_marginBottom="15dp"
                android:textSize="20sp"
                android:textStyle="bold" />

            <include layout="@layout/kompartemen_holder"
                android:id="@+id/kompartemen_1"
                android:visibility="visible"/>

            <include layout="@layout/card_view_holder"
                android:visibility="visible"
                android:id="@+id/search_holder_1"/>

            <TextView
                android:id="@+id/txt_kompartemen_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KOMPARTEMEN 2"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <include layout="@layout/kompartemen_holder"
                android:id="@+id/kompartemen_2"
                android:visibility="gone"/>

            <include layout="@layout/card_view_holder"
                android:visibility="gone"
                android:id="@+id/search_holder_2"/>

            <TextView
                android:id="@+id/txt_kompartemen_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KOMPARTEMEN 3"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <include layout="@layout/kompartemen_holder"
                android:id="@+id/kompartemen_3"
                android:visibility="gone"/>

            <include layout="@layout/card_view_holder"
                android:visibility="gone"
                android:id="@+id/search_holder_3"/>


            <Button
                android:id="@+id/buttonSaveData"
                android:text="Simpan Data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="100dp"
                android:background="@drawable/radio_selected_tangki"
                android:foreground="?attr/selectableItemBackground"/>
        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>