<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.calculator.CalculatorActivity">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        android:fitsSystemWindows="true"
        >

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            app:titleTextColor="@color/white"
            app:navigationIconTint="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/help_menu"
            app:iconTint="@color/white"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">


            <TextView
                android:id="@+id/idTVSecondary"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@color/white"
                android:gravity="bottom"
                android:maxLines="1"
                android:padding="10dp"
                android:paddingTop="30dp"
                android:text=""
                android:textAlignment="viewEnd"
                android:textSize="15sp"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/idTVprimary"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_below="@id/idTVSecondary"
                android:background="@color/white"
                android:gravity="bottom"
                android:maxLines="3"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="50sp"
                android:autoSizeStepGranularity="2sp"
                android:padding="10dp"
                android:text=""
                android:hint="0"
                android:textAlignment="viewEnd"

                android:textSize="50sp"
                tools:ignore="RtlCompat" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/idTVprimary"
                android:background="@color/white"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:weightSum="7">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <Button
                                    android:id="@+id/bac"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_selected_tangki"
                                    android:padding="6dp"
                                    android:text="AC"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bc"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="C"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bbrac1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="("
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bbrac2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text=")"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="5">

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bsin"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="sin"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bcos"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="cos"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/btan"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="tan"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/blog"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="log"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bln"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="ln"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="5">

                                <Button
                                    android:id="@+id/bfact"
                                    android:foreground="?attr/selectableItemBackground"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="x!"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bsquare"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="x²"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bsqrt"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="√"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/binv"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="1/x"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bdiv"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="÷"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b7"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="7"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b8"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="8"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b9"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="9"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bmul"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="×"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="4"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b5"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="5"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b6"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="6"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bminus"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="-"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="1"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="2"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="3"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bplus"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="+"
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="70dp"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bpi"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@color/blac_shade_1"
                                    android:padding="6dp"
                                    android:text="π"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/b0"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="0"
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bdot"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="."
                                    android:textColor="#fff"
                                    android:textSize="15sp" />

                                <Button
                                    android:foreground="?attr/selectableItemBackground"
                                    android:id="@+id/bequal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="3dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/radio_normal"
                                    android:padding="6dp"
                                    android:text="="
                                    android:textColor="@color/white"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>
    </ScrollView>

    
    

</androidx.constraintlayout.widget.ConstraintLayout>