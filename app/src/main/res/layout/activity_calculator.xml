<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.calculator.CalculatorActivity">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/appBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        android:fitsSystemWindows="true"
        >

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            app:titleTextColor="@color/white"
            app:navigationIconTint="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/help_menu"
            app:iconTint="@color/white"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>


    <!-- LAYAR DISPLAY -->
    <LinearLayout
        android:id="@+id/displayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@id/scrollButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/idTVSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom|end"
            android:textSize="15sp"
            android:layout_weight="1"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/idTVprimary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="50sp"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeTextType="uniform"
            android:gravity="bottom|end"
            android:hint="0"
            android:textColor="@android:color/black"
            android:textSize="48sp" />
    </LinearLayout>

    <!-- GRID TOMBOL -->
    <ScrollView
        android:id="@+id/scrollButtons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/displayContainer"
       >

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:alignmentMode="alignMargins"
            android:padding="8dp"
            android:useDefaultMargins="true">

            <!-- Gunakan atribut style langsung -->
            <!-- Baris 1 -->
            <Button
                android:id="@+id/bac"
                android:text="AC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="8dp" />

            <Button
                android:id="@+id/bc"
                android:text="C"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="8dp" />

            <Button
                android:id="@+id/bbrac1"
                android:text="("
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="8dp" />

            <Button
                android:id="@+id/bbrac2"
                android:text=")"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="8dp" />

            <Button
                android:id="@+id/bdiv"
                android:text="÷"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="8dp" />

            <!-- Baris 2 -->
            <Button android:id="@+id/bsin" android:text="sin" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bcos" android:text="cos" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/btan" android:text="tan" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/blog" android:text="log" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bln" android:text="ln" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>

            <!-- Baris 3 -->
            <Button android:id="@+id/bfact" android:text="x!" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bsquare" android:text="x²" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bsqrt" android:text="√" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/binv" android:text="1/x" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bmul" android:text="×" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>

            <!-- Baris 4 -->
            <Button android:id="@+id/b7" android:text="7" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b8" android:text="8" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b9" android:text="9" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/bminus" android:text="-" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bplus" android:text="+" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>

            <!-- Baris 5 -->
            <Button android:id="@+id/b4" android:text="4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b5" android:text="5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b6" android:text="6" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/bpi" android:text="π" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>
            <Button android:id="@+id/bequal" android:text="=" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/colorPrimary" android:textColor="@android:color/white"/>

            <!-- Baris 6 -->
            <Button android:id="@+id/b1" android:text="1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b2" android:text="2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b3" android:text="3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/b0" android:text="0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
            <Button android:id="@+id/bdot" android:text="." android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1" android:backgroundTint="@color/grayOf" android:textColor="@android:color/black"/>
        </GridLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
