<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/holder_card_view_quality_control"
    android:clickable="true"
    android:layout_margin="5dp"
    android:elevation="20dp"
    app:cardCornerRadius="8dp"
    android:foreground="?attr/selectableItemBackground"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="No Bridger"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:id="@+id/txt_bridger_holder"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="100000"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="20dp"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:layout_marginEnd="30dp"
            android:layout_toEndOf="@id/txt_bridger_holder"
            android:id="@+id/txt_liter_holder"/>



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="ABC1239"
            android:textSize="15sp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentEnd="true"
            android:gravity="end"
            android:layout_marginEnd="30dp"
            android:layout_below="@id/txt_liter_holder"
            android:layout_toEndOf="@id/txt_bridger_holder"
            android:id="@+id/txt_seal_holder"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Ini adalah Time"
            android:textSize="15sp"
            android:id="@+id/time_data_quilty"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@id/txt_liter_holder"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="operator"
            android:textSize="15sp"
            android:id="@+id/operator"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="10dp"

            android:layout_marginEnd="30dp"
            android:layout_below="@id/time_data_quilty"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="operator"
            android:textSize="15sp"
            android:id="@+id/txt_tangki"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="30dp"
            android:layout_below="@id/time_data_quilty"/>


    </RelativeLayout>

</androidx.cardview.widget.CardView>